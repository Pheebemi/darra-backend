# Django settings
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=False

# Database settings
DB_NAME=darra_app
DB_USER=darra_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=3306

# Email settings
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Paystack settings (current provider)
PAYSTACK_SECRET_KEY=sk_test_your_test_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_test_public_key_here

# Flutterwave settings (alternative provider)
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST_your_test_secret_key_here
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST_your_test_public_key_here
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TEST_your_test_encryption_key_here

# REQUIRED for Flutterwave webhooks. Must match the "Secret hash" set on the
# Flutterwave dashboard. Without it, Flutterwave webhooks are rejected —
# there is no way to distinguish a real callback from a forged one.
FLUTTERWAVE_SECRET_HASH=pick-a-long-random-string

# Payment provider selection
PAYMENT_PROVIDER=paystack  # or 'flutterwave'

# Base URL of the API (Django itself)
BASE_URL=https://your-api-domain.com

# Public address of the FRONTEND. Used for links inside emails (receipts,
# sale alerts, ticket emails). Must be set in production or buyers get links
# pointing at the wrong site.
FRONTEND_URL=https://your-frontend-domain.com
